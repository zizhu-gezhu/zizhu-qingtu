[Unit]
Description=ZizhuQingTu web application
After=network.target

[Service]
Type=simple
User=zizhu-qingtu
Group=zizhu-qingtu
WorkingDirectory=/opt/zizhu-qingtu/dist/standalone
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
